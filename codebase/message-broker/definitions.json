      "name": "orchestrator.live-lifecycle.v1",
      "vhost": "/streaming",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "streaming.events.dlx"
      }
    },
    {
      "name": "orchestrator.live-lifecycle.retry.5s.v1",
      "vhost": "/streaming",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-message-ttl": 5000,
        "x-dead-letter-exchange": "streaming.events",
        "x-dead-letter-routing-key": "live.ingest.retry.v1"
      }
    },
    {
      "name": "orchestrator.live-lifecycle.dlq.v1",
      "vhost": "/streaming",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    }
  ],
  "exchanges": [
    {
      "name": "streaming.events",
      "vhost": "/streaming",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "streaming.events.retry",
      "vhost": "/streaming",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
